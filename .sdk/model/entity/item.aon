# Entity: item

main: kit: entity: item: {

  alias: field: {}

  fields: [
    {
      name: "cmsLocaleId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "fieldData"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "lastPublished"
      req: false
      type: "`$STRING`"
    }
    {
      name: "lastUpdated"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "item"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "collection_id"
                orig: "collection_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/collections/{collection_id}/items"
          segments: [
            {
              lit: "collections"
            }
            {
              var: "collection_id"
            }
            {
              lit: "items"
            }
          ]
          select: {
            exist: [
              "collection_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "collection_id"
                orig: "collection_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "id"
                orig: "item_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/collections/{collection_id}/items/{item_id}"
          rename: {
            param: {
              item_id: "id"
            }
          }
          segments: [
            {
              lit: "collections"
            }
            {
              var: "collection_id"
            }
            {
              lit: "items"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "collection_id"
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.fieldData`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "collection"
      ]
    ]
  }



}
